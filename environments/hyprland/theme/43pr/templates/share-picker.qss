QWidget {
    background-color: {{bg}};
    color: {{fg}};
    font-family: "Roboto Mono";
    font-size: 10pt;
    selection-background-color: {{accent}};
    selection-color: {{bg}};
}
QScrollArea, QTabWidget::pane {
    border: 1px solid {{border}};
    border-radius: 8px;
}
QPushButton {
    background-color: {{bg_card}};
    border: 1px solid {{border}};
    border-radius: 6px;
    padding: 8px 12px;
}
QPushButton:hover, QPushButton:focus {
    background-color: {{bg_track}};
    border-color: {{accent}};
}
QPushButton:pressed, QPushButton:checked {
    background-color: {{accent}};
    color: {{bg}};
}
QTabBar::tab {
    background-color: {{bg_card}};
    color: {{fg_dim}};
    border: 1px solid {{border}};
    padding: 8px 16px;
}
QTabBar::tab:selected {
    color: {{fg}};
    border-bottom: 2px solid {{accent}};
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid {{border}};
    border-radius: 4px;
    background-color: {{bg_card}};
}
QCheckBox::indicator:checked {
    background-color: {{accent}};
    border-color: {{accent}};
}
QScrollBar:vertical {
    background-color: {{bg}};
    width: 8px;
}
QScrollBar::handle:vertical {
    background-color: {{border}};
    border-radius: 4px;
    min-height: 20px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QToolTip {
    background-color: {{bg_card}};
    color: {{fg}};
    border: 1px solid {{border}};
    padding: 5px;
}
